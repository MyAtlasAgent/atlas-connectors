{
  "description": "Offline transport shapes only. All providers inherit one user policy; native enforcement is not implemented.",
  "permission_policy": "permissions.json",
  "providers": {
    "claude": {
      "prompt_mode": "pointer",
      "cmd": [
        "claude",
        "-p",
        "{prompt}"
      ]
    },
    "codex": {
      "prompt_mode": "inline",
      "cmd": [
        "codex",
        "exec",
        "-o",
        "{worktree}/return.md",
        "{prompt}"
      ]
    },
    "supergrok_cli": {
      "prompt_mode": "file",
      "cmd": [
        "grok-mission",
        "{packet}",
        "{worktree}/return.md",
        "{worktree}"
      ]
    },
    "grok_bot_desktop": {
      "transport": "manual_delivery",
      "cmd": null,
      "automatic_connector": "NOT_FOUND_IN_INSPECTED_SOURCES"
    }
  }
}
