{
  "description": "Offline transport shapes only. codex_app is the default route for new users. All providers inherit one user policy.",
  "permission_policy": "permissions.json",
  "providers": {
    "codex_app": {
      "transport": "codex_app",
      "mode": "auto_send",
      "executable": "codex",
      "cmd": null
    },
    "claude_app": {
      "transport": "claude_app",
      "mode": "prefill",
      "surface": "code",
      "cmd": null
    },
    "claude": {
      "prompt_mode": "pointer",
      "cmd": [
        "claude",
        "-p",
        "{prompt}"
      ]
    },
    "codex": {
      "prompt_mode": "inline",
      "cmd": [
        "codex",
        "exec",
        "-o",
        "{worktree}/return.md",
        "{prompt}"
      ]
    },
    "supergrok_cli": {
      "prompt_mode": "file",
      "cmd": [
        "grok-mission",
        "{packet}",
        "{worktree}/return.md",
        "{worktree}"
      ]
    },
    "grok_bot_desktop": {
      "transport": "manual_delivery",
      "cmd": null,
      "automatic_connector": "NOT_FOUND_IN_INSPECTED_SOURCES"
    }
  }
}
